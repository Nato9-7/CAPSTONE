DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_remoto
DB_PASSWORD=
DB_NAME=


# Correo (verificación de cuentas). Sin SMTP_HOST los correos solo se muestran en los logs.
# Microsoft 365 / Outlook: smtp.office365.com, puerto 587. Gmail: smtp.gmail.com, 587 (con contraseña de aplicación).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=
CORREO_NOMBRE_REMITENTE=Notificaciones RB Alertas

# URL pública de la API (detrás de Caddy con HTTPS), usada en los enlaces de los correos.
URL_PUBLICA_API=https://rbalerta.duckdns.org

# Cuentas con acceso al panel de administración (separadas por coma). Deben tener el correo verificado.
ADMIN_EMAILS=rbalertas.notificaciones@gmail.com

# Grafo del panel de administración (Neo4j). Sin NEO4J_URI la API funciona igual, sin grafo.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAFO_MINUTOS_SINCRONIZACION=10
