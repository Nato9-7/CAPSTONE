DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_remoto
DB_PASSWORD=
DB_NAME=
# Opcionales: conexiones del pool (1 a 32, por defecto 32) y segundos de espera
# por una conexión libre antes de fallar (por defecto 5).
# DB_POOL_SIZE=32
# DB_POOL_TIMEOUT=5

# Carpeta de fotos y videos subidos. Por defecto, rb_alertas_api/uploads.
# En Docker debe ser un volumen para no perder las evidencias al recrear el contenedor.
# CARPETA_UPLOADS=

# Correo (verificación de cuentas). Sin SMTP_HOST los correos solo se muestran en los logs.
# Microsoft 365 / Outlook: smtp.office365.com, puerto 587. Gmail: smtp.gmail.com, 587 (con contraseña de aplicación).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=
CORREO_NOMBRE_REMITENTE=Notificaciones RB Alertas

# URL pública de la API (detrás de Caddy con HTTPS), usada en los enlaces de los correos.
URL_PUBLICA_API=https://rbalerta.duckdns.org

# Cuentas con acceso al panel de administración (separadas por coma). Deben tener el correo verificado.
ADMIN_EMAILS=rbalertas.notificaciones@gmail.com

# Grafo del panel de administración (Neo4j). Sin NEO4J_URI la API funciona igual, sin grafo.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAFO_MINUTOS_SINCRONIZACION=10

# Notificaciones push (Firebase Cloud Messaging). Ruta al JSON de la cuenta de servicio
# (Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada).
# Ese archivo NO se sube al repositorio. Sin esta variable los avisos solo se muestran en los logs.
FIREBASE_CREDENCIALES=

# Opcionales: reglas para juntar reportes del mismo hecho (misma categoría, a menos
# de estos metros y con menos de estas horas de diferencia).
# INCIDENTE_DISTANCIA_METROS=300
# INCIDENTE_HORAS=3

# Opcionales: zonas de riesgo del mapa (radio para juntar hechos, mínimo de hechos
# para mostrar una zona y desde cuántos es nivel ALTO).
# ZONA_RIESGO_RADIO_METROS=250
# ZONA_RIESGO_MINIMO=2
# ZONA_RIESGO_NIVEL_ALTO=4
